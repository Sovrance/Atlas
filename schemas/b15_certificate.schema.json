{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "atlas/schemas/b15_certificate.schema.json",
  "title": "B15-SURF certificate (v0.3 shape + AGENT_WORK_ORDER_B15-SURF §5 fields)",
  "type": "object",
  "required": [
    "certificate_version", "certificate_class", "problem", "timestamp_utc", "headline",
    "m_layer_stipulations", "calibration_route", "results",
    "soundness", "ground_truth_route", "evidence_level", "pir_level", "layer",
    "assumptions", "prereg_ref", "prereg_sha256", "falsifier_direction",
    "seed", "python_version", "generator_sha256", "certificate_id",
    "verdict", "witness", "impossibility_certificate", "warnings",
    "similarity", "confidence", "correlator",
    "hard_constraints_certified", "score"
  ],
  "properties": {
    "certificate_version": {"type": "string", "enum": ["0.3"]},
    "certificate_class": {"type": "string"},
    "problem": {"type": "string"},
    "timestamp_utc": {"type": "string"},
    "headline": {"type": "string"},
    "m_layer_stipulations": {"type": "array", "items": {"type": "string"}},
    "calibration_route": {"type": "string"},
    "results": {"type": "object"},
    "soundness": {"type": "string", "enum": ["SOUND", "HEURISTIC"]},
    "warnings": {"type": "array", "items": {
      "type": "object", "required": ["location", "text"],
      "properties": {"location": {"type": "string"}, "text": {"type": "string"}},
      "additionalProperties": false}},
    "ground_truth_route": {"type": "string"},
    "witness": {"type": ["object", "null"]},
    "impossibility_certificate": {"type": ["object", "null"]},
    "similarity": {"type": ["string", "null"]},
    "confidence": {"type": ["string", "null"]},
    "correlator": {"type": ["string", "null"]},
    "evidence_level": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4"]},
    "pir_level": {"type": "string", "enum": ["L0", "L1", "L2", "L3"]},
    "layer": {"type": "string", "enum": ["DOMAIN"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "prereg_ref": {"type": "string"},
    "prereg_sha256": {"type": "string"},
    "falsifier_direction": {"type": "string"},
    "seed": {"type": "integer"},
    "python_version": {"type": "string"},
    "generator_sha256": {"type": "string"},
    "certificate_id": {"type": "string"},
    "verdict": {"type": "string", "enum": [
      "FORCED", "PERMITTED", "REJECTED", "NONIDENTIFIABLE",
      "OBSERVATIONALLY_EQUIVALENT", "APPARATUS_LIMITED", "REPRESENTATION_DEPENDENT", "AMBIGUOUS"]},
    "verdict_cause": {"type": ["string", "null"]},
    "verdict_class": {"type": ["array", "null"], "items": {"type": "string"}},
    "verdict_display": {"type": "string"},
    "arithmetic": {"type": "string"},
    "hard_constraints_certified": {"type": "boolean"},
    "score": {"type": "string"},
    "inputs": {"type": "object"},
    "ci_seed_env": {"type": "string"},
    "benchmark": {"type": "string", "enum": ["B15-POS", "B15-POS2", "B15-POS3", "B15-ZERO", "B15-GID"]},
    "pir_facts": {"type": "array"}
  },
  "additionalProperties": false
}
